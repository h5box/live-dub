@@ -1407,3 +1410,41 @@ class IndexTTS2S2MelDecoder(nn.Module):
             "S2Mel DiT CUDA graph runner enabled (per-shape capture, LRU=%d)",
             self.s2mel_dit_cuda_graph_max_graphs,
         )
+
+
+# ---- live-dub: single-pass duration control -------------------------------------------------------------------
+# A request may carry extra_params.target_s (seconds). Its natural length is known only here, from the GPT code
+# count: frames = codes * semantic_time_scale * 1.72, 256-sample hop at 22.05 kHz. The factor is
+# target / natural, clamped to [0.85, 1.25] (the live-dub policy), then S2M + BigVGAN run once.
+# One JSON line per request goes to $LIVEDUB_OMNI_FACTOR_LOG so the caller (a serial queue) can read
+# natural_s / factor / clamped back.
+_LIVEDUB_MIN, _LIVEDUB_MAX = 0.85, 1.25
+_LIVEDUB_FRAME_S = 256 / 22050
+logger.info("[live-dub] single-pass target_s patch loaded")
+
+
+def _livedub_target_factors(infos, code_lens, factors, frames_per_code):
+    import json
+    import os
+    import time
+
+    out = list(factors)
+    for i, info in enumerate(infos or []):
+        t = info.get("target_s")
+        try:
+            t = float(t.item() if hasattr(t, "item") else t) if t is not None else -1.0
+        except Exception:
+            t = -1.0
+        natural_s = int(code_lens[i] * frames_per_code) * _LIVEDUB_FRAME_S
+        rec = {"t": time.time(), "codes": int(code_lens[i]), "natural_s": round(natural_s, 3), "target_s": t}
+        if t > 0 and natural_s > 0:
+            raw = t / natural_s
+            out[i] = min(max(raw, _LIVEDUB_MIN), _LIVEDUB_MAX)
+            rec.update(factor=round(out[i], 4), clamped=out[i] != raw)
+        else:
+            rec.update(factor=round(float(out[i]), 4), clamped=False)
+        path = os.environ.get("LIVEDUB_OMNI_FACTOR_LOG")
+        if path:
+            with open(path, "a") as f:
+                f.write(json.dumps(rec) + "\n")
+    return out
